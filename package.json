{
  "name": "cerca-viva",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cerca Viva - tower defense 2.5D com sinergias elementais e mutações roguelite",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "mobile:init": "npx cap init \"Cerca Viva\" com.cercaviva.jogo --web-dir dist",
    "mobile:sync": "npm run build && npx cap sync android",
    "mobile:apk": "powershell -ExecutionPolicy Bypass -File ./gerar-apk.ps1",
    "mobile:patch": "powershell -ExecutionPolicy Bypass -File ./gerar-patch.ps1",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/local-notifications": "^6.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
